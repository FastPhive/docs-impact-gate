{
  "name": "docs-impact-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic GitHub pull-request gate for documentation and release decisions.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.ts\" \"tests/**/*.ts\" \".github/**/*.yml\" \"marketing/*.yml\" action.yml package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.ts\" \"tests/**/*.ts\" \".github/**/*.yml\" \"marketing/*.yml\" action.yml package.json tsconfig.json .prettierrc.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "ncc build src/index.ts -o dist --minify --license licenses.txt",
    "check": "npm run format:check && npm run typecheck && npm run build && node --check dist/index.js && npm test"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "minimatch": "10.2.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.45.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
